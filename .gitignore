# Environment variables (secrets)
.env*
!.env.example

# Node
node_modules/
npm-debug.log*

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# BDS inspector manifest — copied from the installed @brikdesigns/bds by
# postinstall (keep ignore + copy step together, see brik-bds#1552).
/public/bds-manifest.json

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build outputs
dist/
build/

# Logs
logs/
*.log

# Webflow exports (may contain API keys)
# Uncomment if you don't need these in version control:
# updates/*.zip
# updates/*/

# Webflow exports (auto-generated)
js/webflow.js
updates/
*.DS_Store

# Webflow migration extract output (regenerated on demand)
scripts/.migration-output/

# Notion migration extract output (regenerated on demand, #70)
scripts/.notion-migration-output/

# fidelity-shot.mjs output (tncld#95) — screenshots are build artifacts
.fidelity/
# Any before/after sibling of it. Proving a fidelity change needs a MATCHED
# pair, so a session stashes the diff, re-measures, and parks the result beside
# `.fidelity/` — `.fidelity-before/` is the name this one used. Only the exact
# `.fidelity/` was ignored, so a `git add -A` swept ~2,000 screenshots into the
# commit (caught and undone on #159, tncld#154).
.fidelity-*/

# prune-settings-local.py's own recovery snapshots. The global ignore covers
# `.claude/settings.local.json` but not these, so the pruner's deliberate
# 30-day backup (BACKUP_MIN_AGE_DAYS) surfaces as an untracked file and
# new-task.sh refuses to create a worktree until someone deletes a file the
# tool is keeping on purpose. The four core Brik repos already ignore it.
.claude/settings.local.json.bak.*
