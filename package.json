{
  "name": "tncld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "mkdir -p public && cp node_modules/@brikdesigns/bds/dist/bds-manifest.json public/bds-manifest.json",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "test": "npm run check:content && npm run test:a11y && npm run test:widget-width",
    "test:a11y": "node scripts/test-frame-title.js",
    "test:widget-width": "node scripts/test-review-widget-width.js",
    "deploy:cdn": "bash deploy.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@brikdesigns/bds": "^0.158.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "marked": "^18.0.10",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.17.7"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
